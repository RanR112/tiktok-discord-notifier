# =============================================================================
#  tiktok-discord-notifier — contoh konfigurasi
#  Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
#  JANGAN commit file .env (sudah masuk .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# WAJIB
# -----------------------------------------------------------------------------

# Username TikTok yang dipantau, TANPA tanda @.
TIKTOK_USERNAME=username_tiktok

# -----------------------------------------------------------------------------
# WEBHOOK — minimal salah satu harus diisi.
# Fitur yang webhook-nya kosong akan dinonaktifkan (dengan WARN), aplikasi tetap jalan.
# -----------------------------------------------------------------------------

# Webhook KHUSUS notifikasi LIVE. Tidak pernah dipakai untuk konten.
DISCORD_LIVE_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxx

# Webhook KHUSUS notifikasi konten/video. Tidak pernah dipakai untuk LIVE.
DISCORD_CONTENT_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/yyyyyyyyyyyyyyyy

# -----------------------------------------------------------------------------
# OPSIONAL — polling
# -----------------------------------------------------------------------------

# Jeda antar pengecekan, dalam milliseconds. Minimum 15000 (15 detik).
# 60000 (1 menit) adalah nilai yang sopan dan direkomendasikan.
CHECK_INTERVAL=60000

# Jeda minimum antar UPDATE jumlah penonton pada pesan LIVE yang sama (ms).
# Pesan LIVE di-EDIT, bukan dikirim ulang, agar tidak kena rate limit Discord.
# Set 0 untuk menonaktifkan update penonton sepenuhnya.
LIVE_UPDATE_INTERVAL=300000

# Maksimum notifikasi video yang dikirim dalam satu siklus pengecekan.
# Mencegah banjir pesan kalau tiba-tiba terdeteksi banyak video sekaligus.
MAX_CONTENT_PER_CYCLE=3

# -----------------------------------------------------------------------------
# OPSIONAL — sumber data konten
# -----------------------------------------------------------------------------

# Provider untuk mendeteksi video baru:
#   web       (default) Membaca halaman profil publik TikTok. BEST-EFFORT:
#             TikTok punya WAF anti-bot yang sering memblokir ini. Lihat README.
#   official  TikTok Display API resmi. HANYA bisa untuk akun milik sendiri
#             yang sudah memberi izin OAuth. Perlu TIKTOK_CLIENT_* di bawah.
#   mock      Data dummy dari file. Untuk testing lokal tanpa menyentuh TikTok.
#   disabled  Matikan content monitoring sepenuhnya.
TIKTOK_CONTENT_PROVIDER=web

# Hanya dipakai kalau TIKTOK_CONTENT_PROVIDER=official.
# Daftarkan app di https://developers.tiktok.com/ dan minta scope:
#   user.info.basic, video.list
# Simpan nilai-nilai ini HANYA di .env, jangan di source code.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Hanya dipakai kalau TIKTOK_CONTENT_PROVIDER=mock.
# Path ke file JSON berisi array item konten.
TIKTOK_MOCK_FILE=./data/mock-content.json

# -----------------------------------------------------------------------------
# OPSIONAL — lain-lain
# -----------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# Lokasi file state (anti-duplikat). Harus persisten antar restart.
STATE_FILE=./data/state.json

# Timeout tiap HTTP request (ms).
REQUEST_TIMEOUT=15000

# Berapa kali percobaan ulang saat request gagal (exponential backoff).
MAX_RETRIES=3
